# Public site URL. Use your real domain before deployment.
NEXT_PUBLIC_SITE_URL=https://bullmet.by


# Supabase project settings
# 1. Create project at https://supabase.com
# 2. Copy Project URL and anon public key from Project Settings → API
# 3. Create .env.local and paste values below
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never expose this value in NEXT_PUBLIC_* variables or in the browser.
# Required for protected admin writes, private Storage operations and backups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for product photos. The SQL schema creates it automatically.
NEXT_PUBLIC_SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Bootstrap list is only used by the login UI; actual permissions come from public.profiles.
NEXT_PUBLIC_ADMIN_EMAILS=admin@bullmet.by

# Optional Telegram notifications. Keep both values server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
